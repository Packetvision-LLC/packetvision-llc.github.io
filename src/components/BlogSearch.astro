---
// Blog Search Component
---

<div class="blog-search-container mb-8">
  <div class="relative max-w-md mx-auto">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <input
      type="search"
      id="blog-search"
      placeholder="Search blog posts..."
      class="w-full pl-10 pr-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
    />
  </div>
  
  <!-- Search Results Container -->
  <div id="search-results" class="hidden mt-6">
    <div class="bg-gray-800 rounded-lg p-6">
      <h3 class="text-white font-semibold mb-4">Search Results</h3>
      <div id="search-results-list"></div>
      <div id="search-no-results" class="hidden text-gray-400 text-center py-8">
        No posts found matching your search.
      </div>
    </div>
  </div>
</div>

<script>
  // Initialize Pagefind search
  let pagefind;
  
  async function initializeSearch() {
    try {
      // Load Pagefind script dynamically with better error handling
      if (!window.pagefind) {
        const script = document.createElement('script');
        // Try relative path first, then absolute
        const basePath = import.meta.env.BASE_URL || '/';
        script.src = `${basePath}pagefind/pagefind.js`;
        script.type = 'text/javascript';
        document.head.appendChild(script);
        
        await new Promise((resolve, reject) => {
          script.onload = resolve;
          script.onerror = (error) => {
            console.error('Failed to load Pagefind script:', error);
            // Try fallback path
            const fallbackScript = document.createElement('script');
            fallbackScript.src = '/pagefind/pagefind.js';
            fallbackScript.type = 'text/javascript';
            fallbackScript.onload = resolve;
            fallbackScript.onerror = reject;
            document.head.appendChild(fallbackScript);
          };
        });
      }
      
      pagefind = window.pagefind;
      if (pagefind && typeof pagefind.init === 'function') {
        await pagefind.init();
        console.log('Pagefind initialized successfully');
      } else {
        throw new Error('Pagefind not properly loaded');
      }
    } catch (error) {
      console.error('Failed to initialize Pagefind:', error);
      // Disable search functionality gracefully
      const searchInput = document.getElementById('blog-search');
      if (searchInput) {
        searchInput.placeholder = 'Search temporarily unavailable';
        searchInput.disabled = true;
      }
    }
  }

  // Search function
  async function performSearch(query) {
    if (!pagefind) {
      await initializeSearch();
    }
    
    if (!pagefind) {
      console.error('Pagefind not available');
      return;
    }
    
    if (!query.trim()) {
      hideSearchResults();
      return;
    }

    try {
      const search = await pagefind.search(query);
      displaySearchResults(search.results, query);
    } catch (error) {
      console.error('Search error:', error);
      displaySearchError();
    }
  }

  // Display search results
  async function displaySearchResults(results, query) {
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');

    if (results.length === 0) {
      resultsList.innerHTML = '';
      noResults.classList.remove('hidden');
      resultsContainer.classList.remove('hidden');
      return;
    }

    noResults.classList.add('hidden');
    resultsContainer.classList.remove('hidden');

    // Process and display results
    try {
      const processedResults = await Promise.all(
        results.slice(0, 10).map(async (result) => {
          const data = await result.data();
          return {
            title: data.meta.title || 'Untitled',
            url: data.url,
            excerpt: data.excerpt,
            content: data.content
          };
        })
      );

      resultsList.innerHTML = processedResults.map(result => `
        <article class="mb-6 pb-6 border-b border-gray-700 last:border-b-0">
          <h4 class="text-lg font-semibold text-white mb-2">
            <a href="${result.url}" class="hover:text-blue-400 transition-colors">
              ${result.title}
            </a>
          </h4>
          <p class="text-gray-300 text-sm leading-relaxed">
            ${result.excerpt || 'No preview available.'}
          </p>
          <a href="${result.url}" class="text-blue-400 hover:text-blue-300 text-sm font-medium mt-2 inline-block">
            Read full post →
          </a>
        </article>
      `).join('');
    } catch (error) {
      console.error('Error processing search results:', error);
      displaySearchError();
    }
  }

  // Display search error
  function displaySearchError() {
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');

    noResults.classList.add('hidden');
    resultsContainer.classList.remove('hidden');
    resultsList.innerHTML = `
      <div class="text-center py-8">
        <p class="text-gray-400 mb-2">Search temporarily unavailable</p>
        <p class="text-gray-500 text-sm">Please try again later</p>
      </div>
    `;
  }

  // Hide search results
  function hideSearchResults() {
    const resultsContainer = document.getElementById('search-results');
    resultsContainer.classList.add('hidden');
  }

  // Set up search event listeners
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('blog-search');
    let searchTimeout;

    if (searchInput) {
      // Debounced search
      searchInput.addEventListener('input', function(e) {
        clearTimeout(searchTimeout);
        const query = e.target.value;
        
        if (query.length === 0) {
          hideSearchResults();
          return;
        }
        
        // Only search if we have at least 2 characters
        if (query.length >= 2) {
          searchTimeout = setTimeout(() => {
            performSearch(query);
          }, 300);
        }
      });

      // Clear search on escape
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          searchInput.value = '';
          hideSearchResults();
        }
      });
    }

    // Initialize search on page load
    setTimeout(initializeSearch, 1000); // Delay to ensure page is fully loaded
  });
</script>

<style>
  /* Custom styling for search results */
  #search-results-list a {
    text-decoration: none;
  }
  
  #search-results-list article:hover {
    background-color: rgba(55, 65, 81, 0.3);
    border-radius: 0.5rem;
    padding: 1rem;
    margin: -1rem;
  }
</style>