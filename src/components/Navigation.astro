---
// Navigation component for Packetvision site
---

<nav class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo and Brand -->
      <div class="flex items-center space-x-3">
        <img src="/packetvision-logo.png" alt="Packetvision LLC" class="h-8 w-8 object-contain" />
        <a href="/" class="text-xl font-bold text-white hover:text-blue-400 transition-colors">
          Packetvision LLC
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="flex items-center space-x-8">
          <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
          <a href="/about" class="text-gray-300 hover:text-white transition-colors">About</a>
          <a href="/services" class="text-gray-300 hover:text-white transition-colors">Services</a>
          <a href="/products" class="text-gray-300 hover:text-white transition-colors">Products</a>
          <a href="/blog" class="text-gray-300 hover:text-white transition-colors">Blog</a>
          <a href="/hosting" class="text-gray-300 hover:text-white transition-colors">Hosting</a>
          <a href="/contact" class="text-gray-300 hover:text-white transition-colors">Contact</a>
          <a href="#" id="nav-contact" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
            Get Started
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button type="button" id="mobile-menu-button" class="text-gray-300 hover:text-white focus:outline-none">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 border-t border-gray-800">
        <a href="/" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Home</a>
        <a href="/about" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">About</a>
        <a href="/services" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Services</a>
        <a href="/products" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Products</a>
        <a href="/blog" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Blog</a>
        <a href="/hosting" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Hosting</a>
        <a href="/contact" class="block px-3 py-2 text-gray-300 hover:text-white transition-colors">Contact</a>
        <a href="#" id="mobile-nav-contact" class="block mx-3 mt-4 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium text-center transition-colors">
          Get Started
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Email Obfuscation & Mobile Menu Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Email obfuscation
    const email = 'stuart' + '@' + 'packetvision.net';
    const navContactElements = document.querySelectorAll('#nav-contact, #mobile-nav-contact');
    navContactElements.forEach(element => {
      element.href = 'mailto:' + email;
    });

    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });

      // Close mobile menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', function() {
          mobileMenu.classList.add('hidden');
        });
      });
    }
  });
</script>