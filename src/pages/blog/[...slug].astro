---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog', ({ data }) => {
    return !data.draft;
  });
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} - Packetvision LLC Blog`} description={post.data.description}>
  <article class="container mx-auto px-4 py-16">
    <!-- Article Header -->
    <header class="text-center mb-12">
      <div class="flex items-center justify-center gap-4 mb-6">
        <time class="text-blue-400 font-medium">
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {post.data.updatedDate && (
          <span class="text-gray-500">
            • Updated {post.data.updatedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </span>
        )}
      </div>
      
      <h1 class="text-5xl font-bold mb-6 text-white leading-tight">{post.data.title}</h1>
      
      <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          {post.data.tags.map((tag) => (
            <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm">
              {tag}
            </span>
          ))}
        </div>
      )}

      {post.data.heroImage && (
        <div class="max-w-4xl mx-auto">
          <img 
            src={post.data.heroImage} 
            alt={post.data.title}
            class="w-full h-64 md:h-96 object-cover rounded-xl"
          />
        </div>
      )}
    </header>

    <!-- Article Content -->
    <div class="prose prose-lg prose-invert max-w-4xl mx-auto">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="max-w-4xl mx-auto mt-16 pt-8 border-t border-gray-700">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <a href="/blog" class="text-blue-400 hover:text-blue-300 font-medium inline-flex items-center gap-2 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Blog
        </a>
        
        <div class="text-gray-400 text-sm">
          Have questions? <a href="#" id="blog-post-contact" class="text-blue-400 hover:text-blue-300 transition-colors">Get in touch</a>
        </div>
      </div>
    </footer>
  </article>

  <!-- Email Obfuscation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const email = 'stuart' + '@' + 'packetvision.net';
      const contactElement = document.getElementById('blog-post-contact') as HTMLAnchorElement | null;
      
      if (contactElement) {
        contactElement.href = 'mailto:' + email;
      }
    });
  </script>
</BaseLayout>

<style>
  .prose {
    color: #d1d5db;
  }
  
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: #ffffff;
  }
  
  .prose a {
    color: #60a5fa;
  }
  
  .prose a:hover {
    color: #93c5fd;
  }
  
  .prose code {
    background-color: #374151;
    color: #d1d5db;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  
  .prose pre {
    background-color: #1f2937;
    border: 1px solid #374151;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
  }
  
  .prose blockquote {
    border-left: 4px solid #60a5fa;
    background-color: #1f2937;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
  }
  
  .prose img {
    border-radius: 0.5rem;
  }
  
  .prose table {
    background-color: #1f2937;
  }
  
  .prose th {
    background-color: #374151;
    color: #ffffff;
  }
  
  .prose td {
    border-color: #4b5563;
  }
</style>