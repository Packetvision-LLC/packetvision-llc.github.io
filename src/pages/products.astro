---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Products - Packetvision LLC | Innovative Software Solutions" 
           description="Explore our open-source and commercial software products including Mnemogram AI memory service and Deadrop messaging system.">
	<div class="container mx-auto px-4 py-16">
		<!-- Header Section -->
		<section class="text-center mb-16">
			<h1 class="text-5xl font-bold mb-6 text-white">Our Products</h1>
			<p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
				We build and maintain innovative software solutions that solve real-world problems. 
				From AI-powered memory systems to secure communication tools, our products showcase 
				the same quality and attention to detail we bring to client projects.
			</p>
		</section>

		<!-- Products Grid -->
		<section class="grid lg:grid-cols-2 gap-12 mb-16">
			<!-- Mnemogram -->
			<div class="bg-gray-800 rounded-xl overflow-hidden hover:bg-gray-750 transition-colors">
				<div class="p-8">
					<div class="flex items-center mb-6">
						<img src="/mnemogram-logo.png" alt="Mnemogram" class="h-12 w-12 object-contain mr-4" />
						<div>
							<h2 class="text-3xl font-bold text-white">Mnemogram</h2>
							<p class="text-blue-400 font-medium">AI Memory & Knowledge Management</p>
						</div>
					</div>
					
					<p class="text-gray-300 text-lg mb-6 leading-relaxed">
						A serverless AI-powered memory and knowledge management service that helps you store, 
						search, and retrieve information intelligently. Built with Rust, TypeScript, and AWS Lambda.
					</p>

					<div class="mb-6">
						<h3 class="text-xl font-semibold text-white mb-3">Key Features</h3>
						<ul class="text-gray-300 space-y-2">
							<li class="flex items-start">
								<span class="text-blue-400 mr-2">•</span>
								<span>Vector-based semantic search powered by AI embeddings</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-400 mr-2">•</span>
								<span>RESTful API with TypeScript and Python SDKs</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-400 mr-2">•</span>
								<span>Serverless architecture with automatic scaling</span>
							</li>
							<li class="flex items-start">
								<span class="text-blue-400 mr-2">•</span>
								<span>Multi-format support (text, documents, structured data)</span>
							</li>
						</ul>
					</div>

					<div class="mb-8">
						<h3 class="text-xl font-semibold text-white mb-3">Technology Stack</h3>
						<div class="flex flex-wrap gap-2">
							<span class="bg-orange-600 text-white px-3 py-1 rounded-full text-sm font-medium">Rust</span>
							<span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-medium">TypeScript</span>
							<span class="bg-yellow-600 text-white px-3 py-1 rounded-full text-sm font-medium">Python</span>
							<span class="bg-orange-500 text-white px-3 py-1 rounded-full text-sm font-medium">AWS Lambda</span>
							<span class="bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium">OpenAI</span>
							<span class="bg-purple-600 text-white px-3 py-1 rounded-full text-sm font-medium">CDK</span>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row gap-4">
						<a href="https://mnemogram.ai" 
						   class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors" 
						   target="_blank" rel="noopener noreferrer">
							Visit Website
						</a>
						<a href="https://github.com/Packetvision-LLC/mnemogram" 
						   class="border border-gray-600 hover:border-gray-500 text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors"
						   target="_blank" rel="noopener noreferrer">
							View on GitHub
						</a>
					</div>
				</div>
			</div>

			<!-- Deadrop -->
			<div class="bg-gray-800 rounded-xl overflow-hidden hover:bg-gray-750 transition-colors">
				<div class="p-8">
					<div class="flex items-center mb-6">
						<div class="h-12 w-12 bg-gray-700 rounded-lg flex items-center justify-center mr-4">
							<span class="text-2xl">📬</span>
						</div>
						<div>
							<h2 class="text-3xl font-bold text-white">Deadrop</h2>
							<p class="text-green-400 font-medium">Inter-Agent Message Queue</p>
						</div>
					</div>
					
					<p class="text-gray-300 text-lg mb-6 leading-relaxed">
						A secure, SQLite-based message queue system designed for AI agent communication. 
						Enables reliable asynchronous messaging between automated systems with built-in persistence.
					</p>

					<div class="mb-6">
						<h3 class="text-xl font-semibold text-white mb-3">Key Features</h3>
						<ul class="text-gray-300 space-y-2">
							<li class="flex items-start">
								<span class="text-green-400 mr-2">•</span>
								<span>Persistent SQLite-backed message storage</span>
							</li>
							<li class="flex items-start">
								<span class="text-green-400 mr-2">•</span>
								<span>Command-line interface for easy integration</span>
							</li>
							<li class="flex items-start">
								<span class="text-green-400 mr-2">•</span>
								<span>Agent-to-agent communication protocols</span>
							</li>
							<li class="flex items-start">
								<span class="text-green-400 mr-2">•</span>
								<span>Message acknowledgment and status tracking</span>
							</li>
						</ul>
					</div>

					<div class="mb-8">
						<h3 class="text-xl font-semibold text-white mb-3">Technology Stack</h3>
						<div class="flex flex-wrap gap-2">
							<span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-medium">TypeScript</span>
							<span class="bg-gray-600 text-white px-3 py-1 rounded-full text-sm font-medium">SQLite</span>
							<span class="bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium">Node.js</span>
							<span class="bg-purple-600 text-white px-3 py-1 rounded-full text-sm font-medium">CLI</span>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row gap-4">
						<a href="https://github.com/Packetvision-LLC/deadrop" 
						   class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors"
						   target="_blank" rel="noopener noreferrer">
							View on GitHub
						</a>
						<a href="#" 
						   id="deadrop-contact"
						   class="border border-gray-600 hover:border-gray-500 text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors">
							Learn More
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Open Source Commitment -->
		<section class="text-center bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl mb-16">
			<h2 class="text-3xl font-bold text-white mb-6">Open Source Commitment</h2>
			<p class="text-gray-300 text-lg mb-8 max-w-4xl mx-auto leading-relaxed">
				We believe in contributing to the developer community. Our products are built with open source 
				technologies and many are available under permissive licenses. We actively maintain SDKs, 
				documentation, and provide community support.
			</p>
			
			<div class="grid md:grid-cols-3 gap-6 text-center">
				<div>
					<div class="text-3xl font-bold text-blue-400 mb-2">MIT</div>
					<div class="text-gray-300">Open Source License</div>
				</div>
				<div>
					<div class="text-3xl font-bold text-green-400 mb-2">2+</div>
					<div class="text-gray-300">Active Products</div>
				</div>
				<div>
					<div class="text-3xl font-bold text-purple-400 mb-2">∞</div>
					<div class="text-gray-300">Community Support</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
			<h2 class="text-4xl font-bold mb-4 text-white">Need a Custom Solution?</h2>
			<p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
				These products showcase our technical capabilities. We can build similar solutions 
				tailored to your specific business needs, from concept to deployment and ongoing maintenance.
			</p>
			<a href="#" 
			   id="products-cta" 
			   class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors inline-block">
				Discuss Your Project
			</a>
		</section>
	</div>

	<!-- Email Obfuscation Script -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Obfuscate email addresses
			const email = 'stuart' + '@' + 'packetvision.net';
			const contactElements = document.querySelectorAll<HTMLAnchorElement>('#deadrop-contact, #products-cta');
			
			contactElements.forEach((element) => {
				element.href = 'mailto:' + email;
			});
		});
	</script>
</BaseLayout>