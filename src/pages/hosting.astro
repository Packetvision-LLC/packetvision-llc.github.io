---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Web Hosting & Cloud Infrastructure - Packetvision LLC" 
           description="Professional web hosting, cloud infrastructure management, and managed services for businesses. AWS-certified solutions with 24/7 monitoring.">
	<div class="container mx-auto px-4 py-16">
		<!-- Header Section -->
		<section class="text-center mb-16">
			<h1 class="text-5xl font-bold mb-6 text-white">Web Hosting & Infrastructure</h1>
			<p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
				Reliable, secure, and scalable hosting solutions powered by AWS cloud infrastructure. 
				From simple websites to complex applications, we provide the hosting environment 
				your business needs to succeed online.
			</p>
		</section>

		<!-- Custom Solutions Section -->
		<section class="mb-16">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-white mb-6">Custom Hosting Solutions</h2>
				<p class="text-gray-300 text-lg max-w-4xl mx-auto leading-relaxed">
					Every business has unique hosting requirements. We design and implement custom hosting solutions 
					tailored specifically to your needs, performance requirements, and budget. No cookie-cutter packages 
					— just the perfect infrastructure for your business.
				</p>
			</div>

			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<h3 class="text-2xl font-bold text-white mb-6">Tailored to Your Business</h3>
					<p class="text-gray-300 mb-4 leading-relaxed">
						We start by understanding your specific requirements — traffic patterns, security needs, 
						compliance requirements, growth projections, and budget constraints. Then we design a hosting 
						architecture that fits like a glove.
					</p>
					<p class="text-gray-300 mb-6 leading-relaxed">
						Whether you need a simple website host, a complex multi-tier application environment, 
						or anything in between, we build solutions that scale with your business and provide 
						the performance and reliability you need.
					</p>

					<div class="space-y-4">
						<div class="flex items-start gap-3">
							<div class="w-2 h-2 bg-blue-400 rounded-full mt-2 flex-shrink-0"></div>
							<div>
								<h4 class="text-white font-semibold mb-1">Consultation & Analysis</h4>
								<p class="text-gray-300 text-sm">We assess your current needs and future growth plans</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-2 h-2 bg-blue-400 rounded-full mt-2 flex-shrink-0"></div>
							<div>
								<h4 class="text-white font-semibold mb-1">Custom Architecture Design</h4>
								<p class="text-gray-300 text-sm">Tailored infrastructure that meets your exact requirements</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-2 h-2 bg-blue-400 rounded-full mt-2 flex-shrink-0"></div>
							<div>
								<h4 class="text-white font-semibold mb-1">Transparent Pricing</h4>
								<p class="text-gray-300 text-sm">No hidden fees — you pay only for what you need</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-2 h-2 bg-blue-400 rounded-full mt-2 flex-shrink-0"></div>
							<div>
								<h4 class="text-white font-semibold mb-1">Ongoing Support & Optimization</h4>
								<p class="text-gray-300 text-sm">Continuous monitoring and performance tuning</p>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<h3 class="text-xl font-semibold text-white mb-6">What We Consider</h3>
					<ul class="space-y-3 text-gray-300">
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Traffic & Performance:</strong> Expected visitors, peak loads, response time requirements</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Security & Compliance:</strong> Data protection, regulatory requirements, access controls</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Scalability:</strong> Growth projections, seasonal variations, expansion plans</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Integration:</strong> Existing systems, third-party services, development workflows</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Budget:</strong> Operating costs, cost optimization opportunities, ROI targets</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-blue-400 mr-2">•</span>
							<span><strong>Maintenance:</strong> Support level preferences, backup requirements, update policies</span>
						</li>
					</ul>

					<div class="mt-8 p-4 bg-blue-900/30 rounded-lg border border-blue-700">
						<h4 class="text-blue-400 font-semibold mb-2">Free Consultation</h4>
						<p class="text-gray-300 text-sm">
							Every project starts with a no-cost consultation to understand your needs and provide 
							an accurate proposal. No sales pressure — just honest technical guidance.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="mb-16">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-white mb-4">Why Choose Our Hosting?</h2>
				<p class="text-gray-300 text-lg max-w-3xl mx-auto">
					Built on AWS infrastructure with enterprise-grade security and performance optimization.
				</p>
			</div>

			<div class="grid lg:grid-cols-3 md:grid-cols-2 gap-8">
				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Lightning Fast Performance</h3>
					<p class="text-gray-300">
						SSD storage, CDN acceleration, and optimized server configurations ensure your site loads quickly for visitors worldwide.
					</p>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Enterprise Security</h3>
					<p class="text-gray-300">
						SSL certificates, DDoS protection, malware scanning, and regular security updates keep your site safe from threats.
					</p>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">AWS Cloud Infrastructure</h3>
					<p class="text-gray-300">
						Powered by Amazon Web Services with 99.9% uptime SLA, automatic scaling, and global edge locations.
					</p>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Expert Support</h3>
					<p class="text-gray-300">
						Our team of AWS-certified engineers provides personalized support and proactive monitoring for your hosting environment.
					</p>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-indigo-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2M7 4h10M7 4l-2 16h14L17 4M9 10h6"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Automated Backups</h3>
					<p class="text-gray-300">
						Daily automated backups with point-in-time recovery ensure your data is always protected and recoverable.
					</p>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl">
					<div class="w-12 h-12 bg-teal-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Scalable Solutions</h3>
					<p class="text-gray-300">
						Start small and grow big. Our infrastructure scales with your business needs, from simple sites to complex applications.
					</p>
				</div>
			</div>
		</section>

		<!-- Technology Stack -->
		<section class="bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl mb-16">
			<div class="text-center mb-10">
				<h2 class="text-3xl font-bold text-white mb-4">Technology Stack</h2>
				<p class="text-gray-300 text-lg max-w-3xl mx-auto">
					We support modern web technologies and frameworks for optimal performance and compatibility.
				</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<h3 class="text-white font-semibold mb-3">Frontend Frameworks</h3>
					<ul class="text-gray-300 space-y-1">
						<li>React & Next.js</li>
						<li>Vue.js & Nuxt</li>
						<li>Astro & Svelte</li>
						<li>Static site generators</li>
					</ul>
				</div>

				<div class="text-center">
					<h3 class="text-white font-semibold mb-3">Backend Technologies</h3>
					<ul class="text-gray-300 space-y-1">
						<li>Node.js & Python</li>
						<li>Serverless functions</li>
						<li>API gateways</li>
						<li>Microservices</li>
					</ul>
				</div>

				<div class="text-center">
					<h3 class="text-white font-semibold mb-3">Databases</h3>
					<ul class="text-gray-300 space-y-1">
						<li>PostgreSQL</li>
						<li>MySQL</li>
						<li>MongoDB</li>
						<li>DynamoDB</li>
					</ul>
				</div>

				<div class="text-center">
					<h3 class="text-white font-semibold mb-3">DevOps</h3>
					<ul class="text-gray-300 space-y-1">
						<li>CI/CD pipelines</li>
						<li>Docker containers</li>
						<li>Infrastructure as Code</li>
						<li>Monitoring & logging</li>
					</ul>
				</div>
			</div>

			<p class="text-gray-300 text-lg text-center mt-10 max-w-3xl mx-auto">
				<strong class="text-white">Don't see your stack listed?</strong> No problem — our expertise extends well beyond what's listed here. 
				<a href="#" class="text-blue-400 hover:text-blue-300 underline" data-user="stbain" data-domain="proton.me" onclick="this.href='mailto:'+this.dataset.user+'@'+this.dataset.domain">Get in Touch</a> and let's talk about your project.
			</p>
		</section>

		<!-- CTA Section -->
		<section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
			<h2 class="text-4xl font-bold mb-4 text-white">Ready to Build Your Custom Solution?</h2>
			<p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
				Let's discuss your hosting requirements and design a solution that perfectly fits your needs and budget. 
				We offer free consultations with no obligation — just honest technical guidance.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#?subject=Custom%20Hosting%20Consultation" 
				   id="hosting-cta"
				   class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
					Start Free Consultation
				</a>
				<a href="/services" class="border border-white text-white hover:bg-white hover:text-gray-900 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
					View All Services
				</a>
			</div>
		</section>
	</div>

	<!-- Email Obfuscation Script -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Obfuscate email addresses
			const email = 'stuart' + '@' + 'packetvision.net';
			const contactElements = document.querySelectorAll('#hosting-cta');
			
			contactElements.forEach(element => {
				const subject = element.href.split('?subject=')[1] || '';
				element.href = 'mailto:' + email + '?subject=' + encodeURIComponent(subject);
			});
		});
	</script>
</BaseLayout>