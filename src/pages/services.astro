---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout 
  title="Services - Packetvision LLC | Custom Software Development & Cloud Solutions" 
  description="Professional software development services including custom applications, cloud architecture, AI automation, and DevSecOps. Based in Salem, Virginia."
>
  <div class="container mx-auto px-4 py-16">
    <!-- Header -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-6 text-white">Our Services</h1>
      <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
        We provide comprehensive technology solutions designed to help your business succeed in the digital landscape. 
        From initial consultation to deployment and ongoing support, we're your trusted technology partner.
      </p>
    </section>

    <!-- Services Grid -->
    <section class="grid lg:grid-cols-2 gap-12 mb-16">
      <!-- Custom Software Development -->
      <div class="bg-gray-800 p-10 rounded-xl">
        <div class="w-16 h-16 bg-blue-600 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Custom Software Development</h2>
        <p class="text-gray-300 mb-6 leading-relaxed">
          We build tailored software solutions that fit your business requirements perfectly. From web applications 
          to complex enterprise systems, we use modern technologies and best practices to deliver scalable, 
          maintainable software.
        </p>
        
        <h3 class="text-white font-semibold mb-3">Technologies We Use:</h3>
        <ul class="text-gray-300 space-y-2 mb-6">
          <li>• TypeScript, React, Next.js, and Astro for frontend development</li>
          <li>• Node.js, Python, and Rust for backend systems</li>
          <li>• PostgreSQL, MongoDB, and DynamoDB for data management</li>
          <li>• RESTful APIs and GraphQL for service integration</li>
          <li>• Progressive Web Apps (PWAs) for mobile experiences</li>
        </ul>

        <h3 class="text-white font-semibold mb-3">What We Deliver:</h3>
        <ul class="text-gray-300 space-y-2">
          <li>• Full-stack web applications</li>
          <li>• E-commerce and business platforms</li>
          <li>• API development and integration</li>
          <li>• Database design and optimization</li>
          <li>• Legacy system modernization</li>
        </ul>
      </div>

      <!-- Cloud Architecture and Consulting -->
      <div class="bg-gray-800 p-10 rounded-xl">
        <div class="w-16 h-16 bg-orange-600 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Cloud Architecture & Consulting</h2>
        <p class="text-gray-300 mb-6 leading-relaxed">
          We design and implement scalable cloud solutions that reduce costs while improving performance and reliability. 
          Our AWS-certified expertise ensures your infrastructure is built to handle growth and adapt to changing needs.
        </p>

        <h3 class="text-white font-semibold mb-3">AWS Services We Specialize In:</h3>
        <ul class="text-gray-300 space-y-2 mb-6">
          <li>• Lambda and serverless architecture design</li>
          <li>• EC2, ECS, and container orchestration</li>
          <li>• RDS, DynamoDB, and data storage solutions</li>
          <li>• CloudFront, API Gateway, and content delivery</li>
          <li>• IAM, VPC, and security best practices</li>
        </ul>

        <h3 class="text-white font-semibold mb-3">Our Approach:</h3>
        <ul class="text-gray-300 space-y-2">
          <li>• Infrastructure as Code (AWS CDK)</li>
          <li>• Cost optimization and resource management</li>
          <li>• High availability and disaster recovery planning</li>
          <li>• Security hardening and compliance</li>
          <li>• Migration strategy and execution</li>
        </ul>
      </div>

      <!-- AI and Automation Solutions -->
      <div class="bg-gray-800 p-10 rounded-xl">
        <div class="w-16 h-16 bg-purple-600 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">AI & Automation Solutions</h2>
        <p class="text-gray-300 mb-6 leading-relaxed">
          Streamline your operations and gain valuable insights with intelligent automation. We build AI-powered systems 
          that handle routine tasks, process complex data, and provide actionable intelligence for better decision-making.
        </p>

        <h3 class="text-white font-semibold mb-3">AI Technologies:</h3>
        <ul class="text-gray-300 space-y-2 mb-6">
          <li>• Large Language Model (LLM) integration</li>
          <li>• Natural language processing and understanding</li>
          <li>• Computer vision and image analysis</li>
          <li>• Predictive analytics and machine learning</li>
          <li>• Intelligent document processing</li>
        </ul>

        <h3 class="text-white font-semibold mb-3">Automation Solutions:</h3>
        <ul class="text-gray-300 space-y-2">
          <li>• Business process automation</li>
          <li>• Data collection and analysis pipelines</li>
          <li>• Customer service chatbots and assistants</li>
          <li>• Content generation and management</li>
          <li>• Workflow optimization and monitoring</li>
        </ul>
      </div>

      <!-- DevSecOps and Infrastructure -->
      <div class="bg-gray-800 p-10 rounded-xl">
        <div class="w-16 h-16 bg-green-600 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">DevSecOps & Infrastructure</h2>
        <p class="text-gray-300 mb-6 leading-relaxed">
          Secure, automated deployment pipelines that get your software to market faster while maintaining quality and security. 
          We implement modern DevOps practices with security built in from the ground up.
        </p>

        <h3 class="text-white font-semibold mb-3">DevOps Tools & Practices:</h3>
        <ul class="text-gray-300 space-y-2 mb-6">
          <li>• GitHub Actions and GitLab CI/CD pipelines</li>
          <li>• Docker containerization and orchestration</li>
          <li>• Kubernetes cluster management</li>
          <li>• Infrastructure monitoring and alerting</li>
          <li>• Automated testing and quality assurance</li>
        </ul>

        <h3 class="text-white font-semibold mb-3">Security Integration:</h3>
        <ul class="text-gray-300 space-y-2">
          <li>• Security scanning and vulnerability management</li>
          <li>• Compliance automation and reporting</li>
          <li>• Identity and access management (IAM)</li>
          <li>• Network security and encryption</li>
          <li>• Incident response and recovery planning</li>
        </ul>
      </div>
    </section>

    <!-- Process Section -->
    <section class="bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl mb-16">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white mb-4">Our Process</h2>
        <p class="text-gray-300 text-lg max-w-3xl mx-auto">
          We follow a collaborative, agile approach that keeps you informed and involved throughout the project lifecycle.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-bold">1</span>
          </div>
          <h3 class="text-white font-semibold mb-2">Discovery</h3>
          <p class="text-gray-300 text-sm">Understanding your goals, requirements, and technical constraints</p>
        </div>
        
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-bold">2</span>
          </div>
          <h3 class="text-white font-semibold mb-2">Planning</h3>
          <p class="text-gray-300 text-sm">Architecture design, technology selection, and project roadmap</p>
        </div>
        
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-bold">3</span>
          </div>
          <h3 class="text-white font-semibold mb-2">Development</h3>
          <p class="text-gray-300 text-sm">Agile development with regular updates and milestone reviews</p>
        </div>
        
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-bold">4</span>
          </div>
          <h3 class="text-white font-semibold mb-2">Deployment</h3>
          <p class="text-gray-300 text-sm">Secure deployment, testing, and ongoing support</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
      <h2 class="text-4xl font-bold mb-4 text-white">Ready to Get Started?</h2>
      <p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
        Let's discuss your project requirements and how we can help you achieve your technology goals. 
        We offer free initial consultations to explore your needs and provide strategic guidance.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#" id="services-contact" class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
          Start Your Project
        </a>
        <a href="/" class="border border-white text-white hover:bg-white hover:text-gray-900 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
          Learn More
        </a>
      </div>
    </section>
  </div>

  <!-- Email Obfuscation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Obfuscate email addresses
      const email = 'stuart' + '@' + 'packetvision.net';
      const contactElement = document.getElementById('services-contact') as HTMLAnchorElement | null;
      
      if (contactElement) {
        contactElement.href = 'mailto:' + email;
      }
    });
  </script>
</BaseLayout>