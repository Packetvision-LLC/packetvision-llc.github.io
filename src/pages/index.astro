---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Packetvision LLC - Custom Software Development & AI Solutions">
	<div class="container mx-auto px-4 py-16">
		<!-- Hero Section -->
		<section class="text-center mb-16">
			<h1 class="text-5xl font-bold mb-6 text-white">
				Packetvision LLC
			</h1>
			<p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
				Custom software development and AI solutions for modern businesses. 
				We build scalable, secure, and innovative applications that drive your success.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
					Get Started
				</a>
				<a href="/services" class="border border-gray-600 hover:border-gray-500 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
					Our Services
				</a>
			</div>
		</section>

		<!-- Services Preview -->
		<section class="grid md:grid-cols-3 gap-8 mb-16">
			<div class="bg-gray-800 p-8 rounded-lg">
				<h3 class="text-xl font-semibold mb-4 text-white">Custom Software Development</h3>
				<p class="text-gray-300">
					Full-stack web applications, APIs, and enterprise solutions built with modern technologies.
				</p>
			</div>
			<div class="bg-gray-800 p-8 rounded-lg">
				<h3 class="text-xl font-semibold mb-4 text-white">AI & Machine Learning</h3>
				<p class="text-gray-300">
					Intelligent solutions that automate processes and provide data-driven insights.
				</p>
			</div>
			<div class="bg-gray-800 p-8 rounded-lg">
				<h3 class="text-xl font-semibold mb-4 text-white">Cloud Architecture</h3>
				<p class="text-gray-300">
					Scalable AWS solutions with serverless architecture and DevOps best practices.
				</p>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="text-center bg-gray-800 p-12 rounded-lg">
			<h2 class="text-3xl font-bold mb-4 text-white">Ready to Transform Your Business?</h2>
			<p class="text-gray-300 mb-8 max-w-2xl mx-auto">
				Let's discuss how we can help you build the software solutions your business needs to thrive.
			</p>
			<a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors inline-block">
				Contact Us Today
			</a>
		</section>
	</div>
</BaseLayout>
