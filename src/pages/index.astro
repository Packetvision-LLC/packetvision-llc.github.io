---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Packetvision LLC - IT Consulting & Software Development | Salem, VA">
	<div class="container mx-auto px-4 py-16">
		<!-- Hero Section -->
		<section class="text-center mb-20">
			<div class="mb-8">
				<h1 class="text-6xl font-bold mb-4 text-white">
					Packetvision LLC
				</h1>
				<p class="text-lg text-blue-400 mb-8 font-medium">
					IT Consulting & Custom Software Development • Salem, Virginia
				</p>
			</div>
			<p class="text-xl text-gray-300 mb-10 max-w-4xl mx-auto leading-relaxed">
				We partner with businesses to build innovative software solutions that drive growth and efficiency. 
				From cloud-native applications to AI-powered systems, we deliver scalable technology that 
				transforms how you work.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
				<a href="#" id="contact-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
					Start Your Project
				</a>
				<a href="/services" class="border border-gray-600 hover:border-gray-500 text-white px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
					Our Expertise
				</a>
			</div>
			
			<!-- Value Proposition -->
			<div class="grid md:grid-cols-3 gap-6 text-sm text-gray-400">
				<div class="flex items-center justify-center gap-2">
					<span class="w-2 h-2 bg-green-500 rounded-full"></span>
					<span>25+ Years Experience</span>
				</div>
				<div class="flex items-center justify-center gap-2">
					<span class="w-2 h-2 bg-green-500 rounded-full"></span>
					<span>AWS Certified Solutions</span>
				</div>
				<div class="flex items-center justify-center gap-2">
					<span class="w-2 h-2 bg-green-500 rounded-full"></span>
					<span>Agile Development Process</span>
				</div>
			</div>
		</section>

		<!-- Services Section -->
		<section id="services" class="mb-20">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-white mb-4">Our Core Services</h2>
				<p class="text-gray-300 text-lg max-w-2xl mx-auto">
					We specialize in modern software development practices and cutting-edge technologies
				</p>
			</div>
			
			<div class="grid lg:grid-cols-3 md:grid-cols-2 gap-8">
				<div class="bg-gray-800 p-8 rounded-xl hover:bg-gray-750 transition-colors">
					<div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Custom Software Development</h3>
					<p class="text-gray-300 mb-4">
						Full-stack web applications, APIs, and enterprise solutions built with Python, TypeScript, React, Node.js, and modern frameworks.
					</p>
					<ul class="text-sm text-gray-400 space-y-1">
						<li>• Backend Development & Data Processing</li>
						<li>• Next.js & Astro Applications</li>
						<li>• RESTful & GraphQL APIs</li>
						<li>• Database Design & Optimization</li>
						<li>• Progressive Web Apps (PWAs)</li>
					</ul>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl hover:bg-gray-750 transition-colors">
					<div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">AI & Automation Solutions</h3>
					<p class="text-gray-300 mb-4">
						Intelligent systems built with Python that automate workflows, process data, and provide actionable insights for your business.
					</p>
					<ul class="text-sm text-gray-400 space-y-1">
						<li>• AI Agent Development</li>
						<li>• Process Automation & Scripting</li>
						<li>• Data Analysis & Machine Learning</li>
						<li>• Natural Language Processing</li>
						<li>• Workflow Optimization</li>
					</ul>
				</div>

				<div class="bg-gray-800 p-8 rounded-xl hover:bg-gray-750 transition-colors">
					<div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mb-6">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-semibold mb-4 text-white">Cloud Architecture & DevOps</h3>
					<p class="text-gray-300 mb-4">
						Scalable AWS solutions with serverless architecture, containerization, and infrastructure as code.
					</p>
					<ul class="text-sm text-gray-400 space-y-1">
						<li>• AWS Lambda & Serverless</li>
						<li>• Docker & Kubernetes</li>
						<li>• CI/CD Pipelines</li>
						<li>• Infrastructure as Code (CDK)</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section class="mb-20">
			<div class="bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl">
				<div class="max-w-4xl mx-auto text-center">
					<h2 class="text-3xl font-bold text-white mb-6">Why Choose Packetvision?</h2>
					<p class="text-gray-300 text-lg mb-8 leading-relaxed">
						Based in Salem, Virginia, we combine deep technical expertise with a collaborative approach. 
						We don't just build software—we build partnerships that help your business thrive in the digital age.
					</p>
					
					<div class="grid md:grid-cols-2 gap-8 text-left">
						<div>
							<h4 class="text-white font-semibold mb-3">Technical Excellence</h4>
							<p class="text-gray-300 text-sm">
								Modern development practices, clean code, comprehensive testing, and scalable architecture 
								ensure your software grows with your business.
							</p>
						</div>
						<div>
							<h4 class="text-white font-semibold mb-3">Collaborative Partnership</h4>
							<p class="text-gray-300 text-sm">
								We work closely with your team, providing transparency, regular updates, 
								and guidance throughout the development process.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
			<h2 class="text-4xl font-bold mb-4 text-white">Ready to Transform Your Business?</h2>
			<p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
				Let's discuss how we can help you build the software solutions your business needs to thrive. 
				From initial consultation to deployment and beyond, we're your technology partner.
			</p>
			<div class="flex justify-center">
				<a href="#" id="contact-cta" class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
					Get Started Today
				</a>
			</div>
		</section>
	</div>

	<!-- Email Obfuscation Script -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Obfuscate email addresses
			const email = 'stuart' + '@' + 'packetvision.net';
			const contactElements = document.querySelectorAll('#contact-btn, #contact-cta');
			
			contactElements.forEach(element => {
				element.href = 'mailto:' + email;
			});
		});
	</script>
</BaseLayout>
