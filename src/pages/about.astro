---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout 
  title="About - Packetvision LLC | Stuart Bain, Solutions Architect & Founder" 
  description="Learn about Packetvision LLC and founder Stuart Bain - AWS Solutions Architect, USMC veteran, and IT executive with 25+ years of experience in enterprise software development."
>
  <div class="container mx-auto px-4 py-16">
    <!-- Header -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-6 text-white">About Packetvision LLC</h1>
      <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
        Founded in 2002 and based in Salem, Virginia, Packetvision LLC combines deep technical expertise 
        with strategic business insight to deliver innovative software solutions for modern enterprises.
      </p>
    </section>

    <!-- Company Story -->
    <section class="mb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Our Story</h2>
          <p class="text-gray-300 mb-4 leading-relaxed">
            Packetvision LLC was founded with a vision to bridge the gap between complex enterprise technology 
            and practical business solutions. What started as a specialized Linux and open-source consulting firm 
            has evolved into a comprehensive technology partner for businesses of all sizes.
          </p>
          <p class="text-gray-300 mb-4 leading-relaxed">
            Over more than two decades, we've maintained our commitment to technical excellence while expanding 
            our capabilities to include cloud architecture, AI automation, and modern DevSecOps practices. 
            Our approach combines hands-on engineering expertise with strategic business thinking.
          </p>
          <p class="text-gray-300 leading-relaxed">
            Based in the heart of Virginia's Blue Ridge Mountains, we serve clients nationwide, bringing 
            enterprise-grade solutions with the personal touch and reliability of a trusted local partner.
          </p>
        </div>
        
        <div class="bg-gray-800 p-8 rounded-xl">
          <h3 class="text-xl font-semibold text-white mb-6">Company Highlights</h3>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 flex-shrink-0"></span>
              <span><strong>Founded:</strong> 2002 in Salem, Virginia</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 flex-shrink-0"></span>
              <span><strong>Focus:</strong> Enterprise software development, cloud architecture, and AI solutions</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 flex-shrink-0"></span>
              <span><strong>Specialization:</strong> AWS cloud platforms, enterprise applications, open-source technologies</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 flex-shrink-0"></span>
              <span><strong>Philosophy:</strong> Technical excellence with collaborative partnership approach</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Founder Bio -->
    <section class="mb-16">
      <div class="bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="text-4xl font-bold text-white mb-4">Meet Stuart Bain</h2>
            <p class="text-lg text-gray-300">Founder & CEO</p>
          </div>
          
          <div class="text-center">
            <p class="text-gray-300 mb-8 leading-relaxed text-lg max-w-3xl mx-auto">
              Stuart brings over 25 years of technology leadership experience spanning military service, 
              enterprise consulting, and innovative startups. As a United States Marine Corps veteran and 
              AWS Certified Solutions Architect, he combines tactical precision with strategic vision to 
              deliver complex technology solutions.
            </p>
            
            <a href="https://stuartbain.com/about" 
               target="_blank" 
               rel="noopener noreferrer"
               class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors inline-flex items-center gap-2">
              Learn More About Stuart
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Values & Approach -->
    <section class="mb-16">
      <div class="bg-gray-800 p-12 rounded-xl">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-white mb-4">Our Values & Approach</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">
            The principles that guide how we work with clients and approach every project
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-white font-semibold mb-3">Technical Excellence</h3>
            <p class="text-gray-300 text-sm">
              We maintain the highest standards of code quality, security, and architecture design. 
              Every solution is built to scale, perform, and adapt to your evolving needs.
            </p>
          </div>
          
          <div>
            <div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="text-white font-semibold mb-3">Partnership Approach</h3>
            <p class="text-gray-300 text-sm">
              We work as an extension of your team, providing transparent communication, 
              collaborative decision-making, and knowledge transfer throughout every engagement.
            </p>
          </div>
          
          <div>
            <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-white font-semibold mb-3">Mission-Driven</h3>
            <p class="text-gray-300 text-sm">
              Drawing from military service and enterprise leadership, we approach every project 
              with discipline, commitment, and an unwavering focus on mission success.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
      <h2 class="text-4xl font-bold mb-4 text-white">Ready to Work Together?</h2>
      <p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
        Whether you're planning a complex cloud migration, building a new application, 
        or implementing AI-powered automation, we're here to help you succeed.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#" id="about-contact" class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
          Start a Conversation
        </a>
        <a href="/services" class="border border-white text-white hover:bg-white hover:text-gray-900 px-10 py-4 rounded-lg font-semibold text-lg transition-colors">
          View Our Services
        </a>
      </div>
    </section>
  </div>

  <!-- Email Obfuscation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Obfuscate email addresses
      const email = 'stuart' + '@' + 'packetvision.net';
      const contactElement = document.querySelector<HTMLAnchorElement>('#about-contact');
      
      if (contactElement) {
        contactElement.href = 'mailto:' + email;
      }
    });
  </script>
</BaseLayout>
