---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogSearch from '../components/BlogSearch.astro';
import '../styles/global.css';

// Get all published blog posts
const blogPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort posts by date, newest first
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Pagination settings
const pageSize = 10;
const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / pageSize);

// Get first page of posts
const firstPagePosts = sortedPosts.slice(0, pageSize);
const currentPageNum = 1;

// Create page object similar to paginated pages
const page = {
  data: firstPagePosts,
  currentPage: 1,
  lastPage: totalPages,
  total: totalPosts,
  url: {
    prev: null,
    next: totalPages > 1 ? '/blog/2/' : null
  }
};
---

<BaseLayout title="Blog - Packetvision LLC | Technology Insights & Updates" 
           description="Insights on software development, cloud architecture, AI automation, and technology trends from the Packetvision team.">
  <div class="container mx-auto px-4 py-16">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-6 text-white">Technology Blog</h1>
      <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
        Insights on software development, cloud architecture, AI automation, and emerging technologies. 
        We share our experiences, lessons learned, and technical expertise to help the developer community.
      </p>
      {page.lastPage > 1 && (
        <div class="mt-6 text-gray-400">
          Page {currentPageNum} of {page.lastPage} ({page.total} total posts)
        </div>
      )}
    </section>

    <!-- Blog Search -->
    <BlogSearch />

    <!-- Blog Posts Section -->
    {page.data.length > 0 ? (
      <section class="space-y-8 mb-16">
        {page.data.map((post) => (
          <article class="bg-gray-800 rounded-xl p-8 hover:bg-gray-750 transition-colors">
            <div class="flex flex-col lg:flex-row gap-6">
              {post.data.heroImage && (
                <div class="lg:w-1/3">
                  <img 
                    src={post.data.heroImage} 
                    alt={post.data.title}
                    class="w-full h-48 lg:h-32 object-cover rounded-lg"
                  />
                </div>
              )}
              <div class="flex-1">
                <div class="flex items-center gap-4 mb-3">
                  <time class="text-blue-400 font-medium">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="bg-gray-700 text-gray-300 px-2 py-1 rounded text-xs">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <h2 class="text-2xl font-bold text-white mb-3 hover:text-blue-400 transition-colors">
                  <a href={`/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-gray-300 mb-4 leading-relaxed">
                  {post.data.description}
                </p>
                <a 
                  href={`/blog/${post.id}`}
                  class="text-blue-400 hover:text-blue-300 font-medium inline-flex items-center gap-1 transition-colors"
                >
                  Read More
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="text-center py-16">
        <div class="bg-gray-800 rounded-xl p-12">
          <div class="w-16 h-16 bg-gray-700 rounded-xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">No Posts Found</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
            There are no published blog posts at this time. Please check back later for updates.
          </p>
        </div>
      </section>
    )}

    <!-- Pagination Navigation -->
    {page.lastPage > 1 && (
      <nav class="flex justify-center items-center gap-4 mt-16">
        <div class="flex items-center gap-2">
          {page.url.prev && (
            <a
              href={page.url.prev}
              class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Previous
            </a>
          )}
          
          <!-- Page Numbers -->
          <div class="flex gap-1 mx-4">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => (
              <a
                href={pageNum === 1 ? '/blog/' : `/blog/${pageNum}/`}
                class={pageNum === currentPageNum 
                  ? 'px-3 py-2 bg-blue-600 text-white rounded-lg font-medium' 
                  : 'px-3 py-2 bg-gray-800 text-gray-300 rounded-lg hover:bg-gray-700 transition-colors'}
              >
                {pageNum}
              </a>
            ))}
          </div>

          {page.url.next && (
            <a
              href={page.url.next}
              class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors flex items-center gap-2"
            >
              Next
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          )}
        </div>
      </nav>
    )}
  </div>
</BaseLayout>
