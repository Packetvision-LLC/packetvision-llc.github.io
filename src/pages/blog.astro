---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const blogPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort posts by date, newest first
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog - Packetvision LLC | Technology Insights & Updates" 
           description="Insights on software development, cloud architecture, AI automation, and technology trends from the Packetvision team.">
  <div class="container mx-auto px-4 py-16">
    <!-- Header Section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-6 text-white">Technology Blog</h1>
      <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
        Insights on software development, cloud architecture, AI automation, and emerging technologies. 
        We share our experiences, lessons learned, and technical expertise to help the developer community.
      </p>
    </section>

    <!-- Blog Posts Section -->
    {sortedPosts.length > 0 ? (
      <section class="space-y-8 mb-16">
        {sortedPosts.map((post) => (
          <article class="bg-gray-800 rounded-xl p-8 hover:bg-gray-750 transition-colors">
            <div class="flex flex-col lg:flex-row gap-6">
              {post.data.heroImage && (
                <div class="lg:w-1/3">
                  <img 
                    src={post.data.heroImage} 
                    alt={post.data.title}
                    class="w-full h-48 lg:h-32 object-cover rounded-lg"
                  />
                </div>
              )}
              <div class="flex-1">
                <div class="flex items-center gap-4 mb-3">
                  <time class="text-blue-400 font-medium">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  {post.data.tags.length > 0 && (
                    <div class="flex gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="bg-gray-700 text-gray-300 px-2 py-1 rounded text-xs">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <h2 class="text-2xl font-bold text-white mb-3 hover:text-blue-400 transition-colors">
                  <a href={`/blog/${post.slug}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-gray-300 mb-4 leading-relaxed">
                  {post.data.description}
                </p>
                <a 
                  href={`/blog/${post.slug}`}
                  class="text-blue-400 hover:text-blue-300 font-medium inline-flex items-center gap-1 transition-colors"
                >
                  Read More
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <!-- Empty State -->
      <section class="text-center py-16">
        <div class="bg-gray-800 rounded-xl p-12">
          <div class="w-16 h-16 bg-gray-700 rounded-xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">Blog Coming Soon</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
            We're working on bringing you valuable insights about software development, cloud architecture, 
            AI automation, and technology trends. Stay tuned for in-depth articles, tutorials, and case studies.
          </p>
          
          <!-- Newsletter Signup Placeholder -->
          <div class="bg-gray-700 rounded-lg p-6 max-w-md mx-auto">
            <h3 class="text-white font-semibold mb-3">Get Notified</h3>
            <p class="text-gray-300 text-sm mb-4">
              Want to be notified when we publish our first post? Send us an email and we'll let you know.
            </p>
            <a href="mailto:stbain@proton.me?subject=Blog%20Updates" 
               id="blog-notify"
               class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition-colors inline-block">
              Notify Me
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Topics We'll Cover -->
    <section class="bg-gradient-to-r from-gray-800 to-gray-700 p-12 rounded-xl mb-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-white mb-4">Topics We'll Cover</h2>
        <p class="text-gray-300 text-lg max-w-3xl mx-auto">
          Our blog will focus on practical insights and real-world experiences from our development work.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Software Development</h3>
          <p class="text-gray-300 text-sm">Best practices, frameworks, and development workflows</p>
        </div>

        <div class="text-center">
          <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Cloud Architecture</h3>
          <p class="text-gray-300 text-sm">AWS patterns, serverless design, and infrastructure optimization</p>
        </div>

        <div class="text-center">
          <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">AI & Automation</h3>
          <p class="text-gray-300 text-sm">AI integration, automation strategies, and practical implementations</p>
        </div>

        <div class="text-center">
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">DevSecOps</h3>
          <p class="text-gray-300 text-sm">Security practices, CI/CD pipelines, and deployment strategies</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="text-center bg-gradient-to-r from-blue-900 to-purple-900 p-12 rounded-xl">
      <h2 class="text-4xl font-bold mb-4 text-white">Have a Topic Suggestion?</h2>
      <p class="text-gray-200 mb-8 max-w-3xl mx-auto text-lg">
        We'd love to hear what topics you'd like us to cover. Send us your suggestions 
        or questions about software development, cloud architecture, or technology trends.
      </p>
      <a href="mailto:stbain@proton.me?subject=Blog%20Topic%20Suggestion" 
         id="blog-suggestion"
         class="bg-white text-gray-900 hover:bg-gray-100 px-10 py-4 rounded-lg font-semibold text-lg transition-colors inline-block">
        Suggest a Topic
      </a>
    </section>
  </div>

  <!-- Email Obfuscation Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Obfuscate email addresses
      const email = 'stbain' + '@' + 'proton.me';
      const contactElements = document.querySelectorAll('#blog-notify, #blog-suggestion');
      
      contactElements.forEach(element => {
        element.href = element.href.replace('stbain@proton.me', email);
      });
    });
  </script>
</BaseLayout>